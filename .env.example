# BirdWatch Configuration
# Copy this file to .env and fill in your values

# ========== PI CONFIGURATION ==========
# Desktop server URL - Replace with your desktop's local IP
DESKTOP_SERVER_URL=http://192.165.1.184:8000

# Audio settings
SAMPLE_RATE=44100
CHANNELS=1
SILENCE_THRESHOLD=0.01
MIN_RECORDING_SECONDS=3
MAX_RECORDING_SECONDS=15
UPLOAD_ENDPOINT=/upload-audio

# ========== SERVER CONFIGURATION ==========
# Server host and port
HOST=0.0.0.0
PORT=8000

# BirdNET confidence threshold (0.0 to 1.0)
BIRDNET_CONFIDENCE_THRESHOLD=0.7

# Location coordinates for better BirdNET accuracy (optional)
# Fill in your latitude and longitude
LAT=40.7128
LON=-74.0060

# Paths
UPLOAD_DIR=uploads
DATABASE_PATH=birdwatch.db
